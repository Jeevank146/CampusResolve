    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    agent: \"supervisor\",\n    event: item.json.event,\n    status: \"success\",\n    message: \"CampusResolve workflow is working correctly.\"\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        -416
      ],
      "id": "7990efa5-9324-4c57-b118-4086627b3760",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "\nfunction findAnswer(value, depth = 0) {\n  if (depth > 10 || value == null) return '';\n\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      const result = findAnswer(item, depth + 1);\n      if (result) return result;\n    }\n    return '';\n  }\n\n  if (typeof value === 'string') {\n    const text = value.trim();\n\n    if (!text || /workflow was started/i.test(text)) return '';\n\n    if (text.startsWith('{') || text.startsWith('[')) {\n      try {\n        return findAnswer(JSON.parse(text), depth + 1);\n      } catch {\n        // Keep normal text as the answer.\n      }\n    }\n\n    return text;\n  }\n\n  if (typeof value === 'object') {\n    for (const key of [\n      'answer', 'response', 'output', 'text',\n      'n8n_response', 'data', 'result', 'body'\n    ]) {\n      if (value[key] !== undefined) {\n        const result = findAnswer(value[key], depth + 1);\n        if (result) return result;\n      }\n    }\n  }\n\n  return '';\n}\n\nconst answer = findAnswer(\n  $input.all().map(item => item.json)\n);\n\nif (!answer) {\n  throw new Error('Knowledge Agent returned no answer.');\n}\n\nreturn [{\n  json: {\n    status: 'success',\n    agent: 'knowledge',\n    answer,\n    response: answer\n  }\n}];\n"
      },
