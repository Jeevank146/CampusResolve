    {
      "parameters": {
        "sendTo": "={{ $json.body.department_email }}",
        "subject": "={{ 'New Grievance Assigned: ' + $json.body.ticket_code }}",
        "message": "={{ `\n<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;background:#f4f7fc;padding:25px;color:#263858;\">\n\n  <div style=\"background:#173b91;padding:22px;text-align:center;border-radius:10px 10px 0 0;\">\n    <h2 style=\"color:white;margin:0;\">CampusResolve</h2>\n    <p style=\"color:#dbe7ff;margin:8px 0 0;\">Department Notification</p>\n  </div>\n\n  <div style=\"background:white;padding:28px;border:1px solid #e2e8f0;border-radius:0 0 10px 10px;\">\n\n    <h2 style=\"color:#173b91;\">New Grievance Assigned</h2>\n\n    <p>Dear ${$json.body.department},</p>\n\n    <p>A new student grievance has been assigned to your department. Please review the details below and take the necessary action.</p>\n\n    <div style=\"background:#f0f5ff;padding:18px;border-radius:8px;margin:20px 0;\">\n      <p><b>Ticket ID:</b> ${$json.body.ticket_code}</p>\n      <p><b>Student Name:</b> ${$json.body.student_name}</p>\n      <p><b>Issue:</b> ${$json.body.subject}</p>\n      <p><b>Description:</b> ${$json.body.description}</p>\n      <p><b>Priority:</b> ${$json.body.priority}</p>\n      <p><b>Urgency:</b> ${$json.body.urgency}</p>\n    </div>\n\n    <p>Please investigate the concern and update its status through the CampusResolve portal.</p>\n\n    <p style=\"margin-top:28px;\">Regards,<br><b>CampusResolve Support Team</b><br>Vignan University</p>\n  </div>\n\n  <p style=\"text-align:center;color:#8994a8;font-size:11px;margin-top:18px;\">\n    This is an automated notification. Please do not reply.\n  </p>\n</div>\n` }}",
        "options": {}
      },
